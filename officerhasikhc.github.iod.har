            "text": "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1\">\n  <meta name=\"theme-color\" content=\"#1a4d5c\">\n  <meta name=\"description\" content=\"منصة أثر للمبادرات الصحية لتوثيق الفعاليات والمبادرات الصحية بمركز صحي حاسك.\">\n  <meta property=\"og:locale\" content=\"ar_OM\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://officerhasikhc.github.io/health-activities/\">\n  <meta property=\"og:title\" content=\"منصة أثر للمبادرات الصحية\">\n  <meta property=\"og:description\" content=\"توثيق الفعاليات والمبادرات الصحية لمركز صحي حاسك.\">\n  <meta property=\"og:image\" content=\"https://officerhasikhc.github.io/health-activities/assets/social-preview.png\">\n  <meta property=\"og:image:width\" content=\"1200\">\n  <meta property=\"og:image:height\" content=\"630\">\n  <meta property=\"og:image:alt\" content=\"منصة أثر للمبادرات الصحية\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"منصة أثر للمبادرات الصحية\">\n  <meta name=\"twitter:description\" content=\"توثيق الفعاليات والمبادرات الصحية لمركز صحي حاسك.\">\n  <meta name=\"twitter:image\" content=\"https://officerhasikhc.github.io/health-activities/assets/social-preview.png\">\n  <title>منصة أثر للمبادرات الصحية</title>\n  <link rel=\"preconnect\" href=\"https://script.google.com\">\n  <link rel=\"preconnect\" href=\"https://script.googleusercontent.com\">\n  <link rel=\"preconnect\" href=\"https://drive.google.com\">\n  <link rel=\"preconnect\" href=\"https://lh3.googleusercontent.com\">\n  <link rel=\"dns-prefetch\" href=\"https://drive.google.com\">\n  <link rel=\"dns-prefetch\" href=\"https://lh3.googleusercontent.com\">\n  <link rel=\"manifest\" href=\"manifest.webmanifest\">\n  <link rel=\"icon\" href=\"assets/logo-login.png\">\n  <link rel=\"apple-touch-icon\" href=\"assets/logo-login.png\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"styles.css?v=20260614-auth2\">\n</head>\n<body>\n\n  <div id=\"loginScreen\" class=\"login-wrap\">\n    <form class=\"login-card\" id=\"loginForm\" autocomplete=\"off\" onsubmit=\"doLogin(event); return false;\">\n      <img class=\"login-logo\" src=\"assets/logo-login.png\" alt=\"شعار وزارة الصحة\">\n      <div class=\"brand\">منصة أثر</div>\n      <div class=\"brand-sub\">للمبادرات الصحية</div>\n      <div class=\"org-name\">\n        المديرية العامة للخدمات الصحية بمحافظة ظفار<br>\n        التجمّع الصحي (٢) — مركز صحي حاسك\n      </div>\n      \n      <div class=\"login-instructions\">\n        أهلاً بك، يرجى إدخال رقمك الوظيفي وكلمة المرور للمتابعة\n      </div>\n\n      <div class=\"input-group\">\n        <label for=\"empNo\">الرقم الوظيفي</label>\n        <input id=\"empNo\" name=\"username\" type=\"text\" inputmode=\"numeric\" placeholder=\"مثال: 12345\" autocomplete=\"username\" autocapitalize=\"off\" spellcheck=\"false\">\n      </div>\n\n      <div class=\"input-group\">\n        <label for=\"pw\">كلمة المرور</label>\n        <div class=\"pw-wrap\">\n          <input id=\"pw\" name=\"password\" type=\"password\" autocomplete=\"off\" placeholder=\"كلمة المرور\">\n          <button type=\"button\" class=\"pw-toggle\" data-for=\"pw\">إظهار</button>\n        </div>\n        <span class=\"caps-hint\" id=\"capsHint\"></span>\n      </div>\n      \n      <label class=\"remember-row\"><input type=\"checkbox\" id=\"rememberEmp\"> <span>تذكّر الرقم على هذا الجهاز</span></label>\n      \n      <div class=\"login-actions\">\n        <button class=\"btn btn-primary btn-large\" id=\"loginBtn\" type=\"submit\">دخول المنصة</button>\n        <button class=\"btn btn-ghost btn-large install-btn\" type=\"button\" onclick=\"installApp()\">تثبيت التطبيق</button>\n      </div>\n      <div class=\"login-err\" id=\"loginErr\"></div>\n      <div class=\"login-note\">كلمة المرور لأول دخول هي رقمك الوظيفي، وسيُطلب منك تغييرها فورًا.</div>\n    </form>\n  </div>\n\n  <div id=\"resetScreen\" class=\"login-wrap hidden\">\n    <form class=\"login-card\" id=\"resetForm\" autocomplete=\"off\" onsubmit=\"doChangePassword(event); return false;\">\n      <img class=\"login-logo\" src=\"assets/logo-login.png\" alt=\"شعار وزارة الصحة\">\n      <div class=\"brand\">تغيير كلمة المرور</div>\n      <div class=\"brand-sub\">مطلوب قبل المتابعة</div>\n      <input id=\"resetUser\" name=\"username\" type=\"text\" autocomplete=\"username\" class=\"hidden\" readonly>\n\n      <div class=\"input-group\">\n        <label for=\"newPw\">كلمة المرور الجديدة</label>\n        <div class=\"pw-wrap\">\n          <input id=\"newPw\" name=\"new-password\" type=\"password\" autocomplete=\"new-password\" placeholder=\"٦ أحرف على الأقل، حرف ورقم\">\n          <button type=\"button\" class=\"pw-toggle\" data-for=\"newPw\">إظهار</button>\n        </div>\n      </div>\n\n      <div class=\"input-group\">\n        <label for=\"newPw2\">تأكيد كلمة المرور</label>\n        <div class=\"pw-wrap\">\n          <input id=\"newPw2\" name=\"confirm-password\" type=\"password\" autocomplete=\"new-password\" placeholder=\"أعد كتابتها\">\n          <button type=\"button\" class=\"pw-toggle\" data-for=\"newPw2\">إظهار</button>\n        </div>\n      </div>\n\n      <div class=\"login-actions\">\n        <button class=\"btn btn-primary btn-large\" id=\"resetBtn\" type=\"submit\">حفظ ومتابعة</button>\n      </div>\n      <div class=\"login-err\" id=\"resetErr\"></div>\n    </form>\n  </div>\n\n  <div id=\"app\" class=\"hidden\">\n    <header class=\"topbar\">\n      <div class=\"topbar-inner\">\n        <div class=\"logo-box\">\n          <img src=\"assets/logo.png\" alt=\"شعار وزارة الصحة\">\n        </div>\n        <div class=\"org\">\n          <h1>المديرية العامة للخدمات الصحية بمحافظة ظفار</h1>\n          <p>التجمّع الصحي (٢) — مركز صحي حاسك</p>\n        </div>\n        <div class=\"app-title\"><span>منصة أثر</span><strong>للمبادرات الصحية</strong></div>\n        <div class=\"topbar-spacer\"></div>\n        <span id=\"pending\" class=\"pending hidden\"><span class=\"pending-dot\"></span><span class=\"pending-info\"><span class=\"pending-main\" id=\"pendingMain\"></span><span class=\"pending-detail\" id=\"pendingDetail\"></span></span></span>\n        <div class=\"who\">\n          <button id=\"bellIcon\" class=\"bell-btn hidden\" onclick=\"onBellClick()\" title=\"الإشعارات\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg>\n            <span id=\"bellBadge\" class=\"bell-badge hidden\">0</span>\n          </button>\n          <b id=\"whoName\"></b>\n          <button class=\"btn-logout\" onclick=\"logout()\">خروج</button>\n        </div>\n      </div>\n      <div class=\"topbar-sub\">\n        <span id=\"whoTitle\"></span>\n      </div>\n    </header>\n\n    <div class=\"cover\"><span class=\"tag\">توثيق الفعاليات والمبادرات</span></div>\n    <nav class=\"tabs\"><div class=\"tabs-inner\" id=\"tabsBar\"></div></nav>\n    <main id=\"view\"></main>\n  </div>\n\n  <div id=\"modalHost\"></div>\n  <div id=\"toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"><span class=\"toast-bar\"></span><span class=\"toast-icon\"></span><span class=\"toast-msg\"></span></div>\n\n  <script>\n    window.ATHAR_BRIDGE_URL = 'https://script.google.com/macros/s/AKfycbxUg1TtF9Nmr7G_r6m0QznyPAvc2XXNTjJisNOFUTPhFZ2wbyDxrk-s5gx4e7L3w9N9wQ/exec?bridge=1';\n    if ('serviceWorker' in navigator) {\n      window.addEventListener('load', function(){\n        navigator.serviceWorker.register('./sw.js').catch(function(){});\n      });\n    }\n  </script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js\"></script>\n  <script src=\"debug.js?v=20260614-auth2\"></script>\n  <script src=\"server-bridge.js?v=20260614-auth2\"></script>\n  <script src=\"offline.js?v=20260614-auth2\"></script>\n  <script src=\"app.js?v=20260614-auth2\"></script>\n</body>\n</html>\n"
