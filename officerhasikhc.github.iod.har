            "text": ":root{\n    --bg:#f4f5f7; --surface:#ffffff; --ink:#1d2733; --muted:#5b6b7b;\n    --line:#dfe4ea; --line-strong:#c7d0d9;\n    --brand:#1a4d5c;          /* أخضر مزرقّ رسمي هادئ */\n    --brand-deep:#123a46;\n    --accent:#9a7b3f;         /* ذهبي مكتوم للتفاصيل */\n    --ok:#1e7d52; --err:#b23b3b; --warn:#9a7b3f;\n    --radius:6px; --shadow:0 1px 2px rgba(16,34,46,.06),0 1px 3px rgba(16,34,46,.05);\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{\n    font-family:\"Cairo\",\"Segoe UI\",\"Tahoma\",Arial,sans-serif;\n    background:var(--bg); color:var(--ink); direction:rtl; text-align:right;\n    font-size:14px; line-height:1.6; -webkit-font-smoothing:antialiased;\n  }\n  a{color:var(--brand)}\n  .hidden{display:none !important}\n\n  /* ===== الترويسة ===== */\n  header.topbar{\n    background:linear-gradient(180deg,var(--brand) 0%,var(--brand-deep) 100%);\n    color:#eef3f4; border-bottom:3px solid var(--accent);\n  }\n  .topbar-inner{max-width:1080px;margin:0 auto;padding:calc(12px + env(safe-area-inset-top)) 18px 10px;\n    display:flex;align-items:center;gap:14px;position:relative}\n  .logo-box{width:52px;height:52px;border:1px solid rgba(255,255,255,.35);\n    border-radius:6px;display:flex;align-items:center;justify-content:center;\n    font-size:11px;color:#cfe0e3;flex:0 0 auto;background:rgba(255,255,255,.92);overflow:hidden}\n  .logo-box img{width:44px;height:44px;object-fit:contain;transform:translateY(2px)}\n  .org h1{font-size:15px;margin:0;font-weight:600;letter-spacing:.2px}\n  .org p{font-size:12px;margin:2px 0 0;color:#bcd2d6}\n  .app-title{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);\n    display:flex;flex-direction:column;align-items:center;color:#fff;text-align:center;white-space:nowrap;line-height:1.15}\n  .app-title span{font-size:20px;font-weight:700;letter-spacing:0}\n  .app-title strong{font-size:12px;font-weight:500;color:#c9dcdf;letter-spacing:0}\n  .topbar-spacer{flex:1}\n  .who{font-size:12px;text-align:left;color:#dfe9ea;display:flex;align-items:center;gap:8px}\n  .who b{display:block;font-size:12.5px;color:#fff;line-height:1.2}\n  .bell-btn{position:relative;cursor:pointer;background:none;border:none;\n    border-radius:4px;padding:4px;color:rgba(255,255,255,.75);display:flex;align-items:center;\n    justify-content:center;transition:all .15s ease;line-height:0}\n  .bell-btn:hover{color:#fff;background:rgba(255,255,255,.08)}\n  .bell-badge{position:absolute;top:-5px;right:-5px;background:var(--err);color:#fff;\n    font-size:9px;font-weight:700;min-width:14px;height:14px;line-height:14px;\n    padding:0 3px;border-radius:7px;text-align:center}\n  .nav-badge{background:var(--err);color:#fff;font-size:10px;font-weight:bold;padding:2px 6px;border-radius:10px;margin-right:6px;animation:pulseRed 1.5s infinite;display:inline-block;vertical-align:middle}\n  @keyframes pulseRed{0%{box-shadow:0 0 0 0 rgba(178,59,59,0.7)}70%{box-shadow:0 0 0 6px rgba(178,59,59,0)}100%{box-shadow:0 0 0 0 rgba(178,59,59,0)}}\n  .btn-logout{background:transparent;border:1px solid rgba(255,255,255,.25);\n    color:rgba(255,255,255,.8);border-radius:4px;padding:4px 10px;cursor:pointer;font-size:11px;\n    font-family:inherit;white-space:nowrap;transition:all .15s ease}\n  .btn-logout:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.4);color:#fff}\n  .topbar-sub{max-width:1080px;margin:0 auto;padding:0 18px 6px;\n    font-size:11px;color:rgba(207,224,227,.6);text-align:left}\n  .pending{background:rgba(154,123,63,.18);border:1px solid rgba(154,123,63,.35);\n    color:#f3e6c8;border-radius:4px;padding:3px 8px;font-size:11px;margin-left:4px;\n    display:inline-flex;align-items:center;gap:5px;line-height:1.35;\n    transition:all .3s ease;max-width:240px;overflow:hidden}\n  .pending-dot{width:5px;height:5px;border-radius:50%;background:#f3e6c8;\n    flex:0 0 auto;animation:pulse 1.2s ease-in-out infinite}\n  .pending-info{display:flex;flex-direction:column;gap:1px;min-width:0}\n  .pending-main{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11px;font-weight:500}\n  .pending-detail{font-size:9.5px;opacity:.7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n  @keyframes pulse{0%,100%{opacity:.3}50%{opacity:1}}\n\n  /* ===== لافتة خافتة (cover) ===== */\n  .cover{height:96px;position:relative;overflow:hidden;\n    background:\n      linear-gradient(90deg,rgba(26,77,92,.92),rgba(18,58,70,.82)),\n      repeating-linear-gradient(135deg,#1a4d5c 0 22px,#173f4b 22px 44px);\n    border-bottom:1px solid var(--line)}\n  .cover::after{content:\"أثر\";position:absolute;left:24px;bottom:8px;\n    font-size:46px;font-weight:700;color:rgba(255,255,255,.10);letter-spacing:2px}\n  .cover .tag{position:absolute;right:24px;top:50%;transform:translateY(-50%);\n    color:rgba(255,255,255,.85);font-size:13px}\n\n  /* ===== التبويبات ===== */\n  nav.tabs{background:var(--surface);border-bottom:1px solid var(--line)}\n  .tabs-inner{max-width:1080px;margin:0 auto;display:flex;gap:2px;padding:0 12px}\n  .tab{padding:12px 16px;cursor:pointer;color:var(--muted);font-size:13.5px;\n    border-bottom:2px solid transparent;background:none;border-top:none;\n    border-right:none;border-left:none;font-family:inherit}\n  .tab:hover{color:var(--ink)}\n  .tab.active{color:var(--brand);border-bottom-color:var(--accent);font-weight:600}\n\n  /* ===== الحاوية ===== */\n  main{max-width:1080px;margin:0 auto;padding:22px 18px 60px}\n  .card{background:var(--surface);border:1px solid var(--line);\n    border-radius:var(--radius);box-shadow:var(--shadow);padding:20px;margin-bottom:18px}\n  .card h2{font-size:15px;margin:0 0 4px;color:var(--brand-deep)}\n  .card .sub{color:var(--muted);font-size:12.5px;margin:0 0 16px}\n  .section-divider{height:1px;background:var(--line);margin:18px 0}\n\n  /* ===== الحقول ===== */\n  .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 16px}\n  @media(max-width:680px){.grid{grid-template-columns:1fr}}\n  .field{display:flex;flex-direction:column;gap:5px}\n  .field.full{grid-column:1 / -1}\n  label{font-size:12.5px;color:var(--ink);font-weight:600}\n  label .req{color:var(--err);margin-right:2px}\n  input[type=text],input[type=number],input[type=date],input[type=password],select,textarea{\n    width:100%;padding:10px 12px;border:1px solid var(--line-strong);\n    border-radius:6px;font-family:inherit;font-size:14px;color:var(--ink);\n    background:#fff;transition:all .2s ease}\n  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--brand);\n    box-shadow:0 0 0 3px rgba(26,77,92,.15)}\n  textarea{resize:vertical;min-height:70px}\n  .readonly-box{min-height:37px;border:1px solid var(--line);border-radius:5px;\n    background:#f7f9fa;color:var(--brand-deep);padding:8px 10px;font-weight:600}\n  .readonly-box small{display:block;color:var(--muted);font-size:11.5px;font-weight:400;margin-top:1px}\n  .invalid{border-color:var(--err) !important;box-shadow:0 0 0 3px rgba(178,59,59,.10)}\n  .validation-panel{position:fixed;left:18px;top:96px;width:min(300px,calc(100vw - 36px));\n    background:#fff;border:1px solid rgba(178,59,59,.45);border-right:4px solid var(--err);\n    border-radius:7px;box-shadow:0 10px 30px rgba(16,34,46,.18);padding:13px 15px;\n    z-index:70;color:var(--ink)}\n  .validation-panel b{display:block;color:var(--err);margin-bottom:6px}\n  .validation-panel ul{margin:0;padding:0 18px 0 0;color:var(--muted);font-size:12.5px}\n  .validation-panel li{margin:2px 0}\n  .hint{font-size:11.5px;color:var(--muted)}\n\n  /* اختيار الفئات (شرائح) */\n  .chips{display:flex;flex-wrap:wrap;gap:7px}\n  .chips.soft{margin-top:8px}\n  .chip{border:1px solid var(--line-strong);border-radius:20px;padding:5px 12px;\n    cursor:pointer;font-size:12.5px;color:var(--muted);user-select:none;background:#fff}\n  .chip.on{background:var(--brand);color:#fff;border-color:var(--brand)}\n  .chip.muted{opacity:.58}\n\n  /* toggle الشراكة */\n  .toggle-row{display:flex;align-items:center;gap:10px}\n  .switch{position:relative;width:42px;height:22px;flex:0 0 auto}\n  .switch input{opacity:0;width:0;height:0}\n  .slider{position:absolute;inset:0;background:#cdd6dd;border-radius:22px;transition:.2s;cursor:pointer}\n  .slider::before{content:\"\";position:absolute;height:16px;width:16px;right:3px;top:3px;\n    background:#fff;border-radius:50%;transition:.2s}\n  .switch input:checked + .slider{background:var(--brand)}\n  .switch input:checked + .slider::before{transform:translateX(-20px)}\n\n  /* قوائم الإضافة (شراكات/صور) */\n  .add-row{display:flex;gap:8px}\n  .add-row input{flex:1}\n  .tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}\n  .tag-item{background:#eef2f4;border:1px solid var(--line);border-radius:5px;\n    padding:4px 10px;font-size:12.5px;display:flex;align-items:center;gap:8px}\n  .tag-item .x{cursor:pointer;color:var(--err);font-weight:700}\n\n  /* الصور */\n  .photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));\n    gap:10px;margin-top:12px}\n  .photo-thumb{position:relative;aspect-ratio:1;border-radius:6px;overflow:hidden;\n    border:1px solid var(--line)}\n  .photo-thumb img{width:100%;height:100%;object-fit:cover}\n  .photo-thumb .rm{position:absolute;top:4px;left:4px;background:rgba(178,59,59,.9);\n    color:#fff;border:none;border-radius:4px;width:22px;height:22px;cursor:pointer;font-size:14px}\n  button.photo-thumb{padding:0;display:block;cursor:pointer;background:#f4f6f7}\n  .photo-viewer{display:flex;flex-direction:column;gap:10px;align-items:center}\n  .photo-viewer img{width:100%;max-height:68vh;object-fit:contain;border:1px solid var(--line);border-radius:6px;background:#f7f9fa}\n  .photo-count{font-size:12px;color:var(--muted)}\n\n  /* أزرار */\n  .btn{border:none;border-radius:6px;padding:9px 18px;font-size:14px;cursor:pointer;\n    font-family:inherit;font-weight:700;transition:all .2s ease;text-decoration:none;display:inline-flex;\n    align-items:center;justify-content:center;gap:6px;}\n  .btn:disabled{opacity:.6;cursor:not-allowed;transform:none !important;box-shadow:none !important}\n  .btn:focus-visible{outline:3px solid rgba(154,123,63,.35);outline-offset:2px}\n  .btn:not(:disabled):hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.08)}\n  .btn:not(:disabled):active{transform:translateY(0);box-shadow:none}\n  \n  .btn-primary{background:var(--brand);color:#fff}\n  .btn-primary:hover{background:var(--brand-deep)}\n  .btn-ghost{background:#fff;color:var(--ink);border:1px solid var(--line-strong)}\n  .btn-ghost:hover{background:#f4f6f7;border-color:#b4c2ce}\n  .btn-danger{background:var(--err);color:#fff}\n  .btn-edit{background:#e8f2f4;color:var(--brand-deep);border:1px solid #bed6dc}\n  .btn-edit:hover{background:#dcecef}\n  .btn-print{background:#f4efe2;color:#6f5527;border:1px solid #e2d5b7}\n  .btn-print:hover{background:#eee5d3}\n  .btn-view{background:#eef2f4;color:var(--brand-deep);border:1px solid var(--line-strong)}\n  .btn-view:hover{background:#e3ebee}\n  .btn-excel{background:#e8f3ed;color:#1e6b48;border:1px solid #bcd9ca}\n  .btn-excel:hover{background:#dceee5}\n  .btn-pdf{background:#fff;color:var(--brand-deep);border:1px solid var(--line-strong)}\n  .btn-pdf:hover{background:#f4f6f7;border-color:#b4c2ce}\n  .btn-zip{background:#edf2f6;color:#31546b;border:1px solid #c8d7e1}\n  .btn-zip:hover{background:#e1ebf1}\n  .btn-danger-outline{background:#fff;color:var(--err);border:1px solid rgba(178,59,59,.45)}\n  .btn-danger-outline:hover{background:#fff4f4;border-color:var(--err)}\n  .btn-command{min-width:78px;height:34px;padding:7px 12px;border-radius:7px}\n  .btn-command-primary{background:var(--brand);border-color:var(--brand);color:#fff}\n  .btn-command-primary:hover{background:var(--brand-deep)}\n  .btn-icon-command{width:34px;height:34px;min-width:34px;padding:0;border-radius:6px;background:#fff;color:var(--brand-deep);border:1px solid var(--line-strong)}\n  .btn-icon-command:hover{background:#f4f6f7;border-color:#b4c2ce;box-shadow:none}\n  .btn-icon-command.btn-danger-text{color:var(--err);border-color:rgba(178,59,59,.22)}\n  .btn-icon-command.btn-danger-text:hover{background:#fff6f6;border-color:rgba(178,59,59,.38)}\n  .btn-danger-text{background:transparent;color:var(--err);border:1px solid transparent}\n  .btn-danger-text:hover{background:#fff4f4;border-color:rgba(178,59,59,.25);box-shadow:none}\n  .ico{font-size:15px;line-height:1}\n  .btn-sm{padding:7px 14px;font-size:13px}\n  .btn-large{padding:12px 24px;font-size:15px}\n  .actions{display:flex;gap:10px;justify-content:flex-start;margin-top:6px}\n\n  /* الجدول/السجل */\n  .filters{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:14px}\n  .filters .field{min-width:130px}\n  .period-filters{margin-bottom:8px}\n  .period-count-chip{align-self:flex-end;min-height:34px;display:inline-flex;align-items:center;border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 12px;color:var(--brand-deep);font-size:12.5px;font-weight:700}\n  .period-count-chip.hidden{display:none}\n  .action-filters{margin-top:-4px}\n  .rec{border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:14px;\n    background:#fff;display:flex;gap:18px;align-items:flex-start;\n    box-shadow:0 1px 3px rgba(18,58,70,.05);transition:border-color .15s,box-shadow .15s}\n  .rec:hover{border-color:var(--line-strong);box-shadow:0 4px 14px rgba(18,58,70,.10)}\n  .rec-thumb{position:relative;flex:0 0 auto;width:92px;height:92px;border-radius:8px;\n    overflow:hidden;border:1px solid var(--line);background:#f4f6f7;cursor:pointer}\n  .rec-thumb img{width:100%;height:100%;object-fit:cover;display:block}\n  .rec-thumb-count{position:absolute;left:6px;bottom:6px;background:rgba(18,58,70,.82);\n    color:#fff;font-size:11px;font-weight:700;border-radius:10px;padding:1px 8px}\n  .rec-thumb-empty{display:flex;align-items:center;justify-content:center;\n    color:var(--muted);font-size:11px}\n  .rec .meta{flex:1;min-width:0}\n  .rec .ttl{font-weight:700;color:var(--brand-deep);font-size:16.5px;cursor:pointer;\n    line-height:1.4;margin-bottom:6px}\n  .rec .ttl:hover{text-decoration:underline}\n  .rec .row2{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}\n  .rec-facts{display:flex;flex-wrap:wrap;gap:8px 22px}\n  .rec-facts .fact{display:flex;flex-direction:column;color:var(--brand-deep);\n    font-size:13.5px;font-weight:600}\n  .rec-facts .fact i{font-style:normal;color:var(--muted);font-size:11px;\n    font-weight:500;margin-bottom:1px}\n  .badge{display:inline-block;background:#eef2f4;border:1px solid var(--line);\n    border-radius:5px;padding:3px 10px;font-size:12px;color:var(--brand-deep);font-weight:600}\n  .badge.part{background:#f4efe2;border-color:#e3d6b5;color:var(--accent)}\n  .badge.pending-badge{background:#fff7e6;border-color:#e6c982;color:#7a5a15}\n  .rec .ops{display:flex;gap:6px;flex:0 0 auto;flex-wrap:wrap;justify-content:flex-start}\n  .record-actions{align-items:stretch}\n  .sync-note{display:inline-flex;align-items:center;gap:7px;margin:-2px 0 6px;\n    padding:4px 9px;border:1px solid #e7d0a4;border-radius:999px;background:#fff8eb;\n    color:#7a5a15;font-size:11.5px;font-weight:700}\n  .sync-dot{width:6px;height:6px;border-radius:50%;background:#b7812c;\n    box-shadow:0 0 0 3px rgba(183,129,44,.14)}\n  .empty{text-align:center;color:var(--muted);padding:40px 0;font-size:13.5px}\n\n  /* لوحة المؤشرات */\n  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}\n  .kpi{background:#fff;border:1px solid var(--line);border-radius:6px;padding:16px;\n    border-right:3px solid var(--brand)}\n  .kpi .n{font-size:26px;font-weight:700;color:var(--brand-deep)}\n  .kpi .l{font-size:12.5px;color:var(--muted);margin-top:2px}\n  .bars{margin-top:6px}\n  .dash-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap}\n  .dash-head .hint{max-width:620px;text-align:right;line-height:1.7}\n  .bar-row{display:flex;align-items:center;gap:10px;margin:7px 0;font-size:12.5px}\n  button.bar-row{width:100%;font-family:inherit;background:none;border:none;padding:0;cursor:pointer;text-align:inherit}\n  button.bar-row:hover .bar-track{outline:2px solid rgba(26,77,92,.12)}\n  .bar-row .lbl{width:120px;color:var(--ink);text-align:left;flex:0 0 auto}\n  .bar-track{flex:1;background:#eef2f4;border-radius:4px;height:14px;overflow:hidden}\n  .bar-fill{height:100%;background:var(--brand);border-radius:4px}\n  .bar-row .v{width:30px;color:var(--muted)}\n  .dash-result-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}\n  .dash-result-head h3{margin:0;color:var(--brand-deep);font-size:14px}\n  .mini-records{display:grid;gap:8px}\n  .mini-rec{border:1px solid var(--line);border-radius:6px;background:#fff;padding:10px 12px;\n    display:grid;grid-template-columns:minmax(180px,1fr) auto auto auto;gap:8px;align-items:center;font-size:12.5px}\n  .mini-rec b{color:var(--brand-deep)}\n  .mini-rec span{color:var(--muted)}\n  .required-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px}\n  .req-setting{border:1px solid var(--line);border-radius:6px;background:#fff;padding:11px 12px;\n    display:flex;align-items:center;justify-content:space-between;gap:12px}\n  .req-setting b{display:block;color:var(--brand-deep);font-size:13px}\n  .req-setting span{display:block;color:var(--muted);font-size:11.5px;margin-top:2px}\n  .req-setting.locked{background:#f7f9fa}\n\n  /* Modal */\n  .modal-bg{position:fixed;inset:0;background:rgba(16,34,46,.45);display:flex;\n    align-items:center;justify-content:center;z-index:50;padding:18px}\n  .modal{background:#fff;border-radius:8px;max-width:620px;width:100%;max-height:88vh;\n    overflow:auto;box-shadow:0 10px 40px rgba(0,0,0,.25)}\n  .modal-head{padding:16px 20px;border-bottom:1px solid var(--line);\n    display:flex;justify-content:space-between;align-items:center}\n  .modal-head h3{margin:0;font-size:15px;color:var(--brand-deep)}\n  .modal-head .x{cursor:pointer;font-size:22px;color:var(--muted);border:none;background:none}\n  .modal-body{padding:20px}\n  .modal-foot{padding:14px 20px;border-top:1px solid var(--line);\n    display:flex;gap:10px;justify-content:flex-start}\n  .dl-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed var(--line);font-size:13px}\n  .dl-row span:first-child{color:var(--muted);min-width:130px}\n\n  .readiness-intro{margin:0 0 12px;color:var(--ink);line-height:1.8}\n  .readiness-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}\n  .readiness-item{border:1px solid var(--line);border-right-width:4px;border-radius:8px;padding:9px 10px;background:#fff}\n  .readiness-item b{display:block;font-size:13px;margin-bottom:3px;color:var(--ink)}\n  .readiness-item span{display:block;font-size:12.5px;color:var(--muted);line-height:1.7}\n  .readiness-item.blocking{border-right-color:var(--err);background:#fff7f6}\n  .readiness-item.warning{border-right-color:#b7812c;background:#fffaf0}\n  .readiness-records{display:flex;flex-direction:column;gap:10px;max-height:58vh;overflow:auto;padding-left:4px}\n  .readiness-record{border:1px solid var(--line);border-radius:8px;padding:10px;background:#fbfcfd}\n  .readiness-record>b{display:block;color:var(--brand-deep);font-size:13.5px;margin-bottom:2px}\n  .readiness-record>span{display:block;color:var(--muted);font-size:12px;margin-bottom:8px}\n\n  /* تنبيهات (toast) */\n  #toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(80px);\n    background:#fff;color:var(--ink);padding:0;border-radius:8px;\n    font-size:13px;box-shadow:0 8px 32px rgba(16,34,46,.18),0 2px 8px rgba(0,0,0,.08);\n    opacity:0;transition:all .35s cubic-bezier(.4,0,.2,1);z-index:80;\n    display:flex;align-items:stretch;overflow:hidden;border:1px solid var(--line);\n    max-width:min(420px,calc(100vw - 32px));min-width:200px}\n  #toast .toast-bar{width:4px;flex:0 0 4px;background:var(--brand)}\n  #toast .toast-icon{display:flex;align-items:center;justify-content:center;\n    width:36px;flex:0 0 36px;font-size:16px;color:var(--brand)}\n  #toast .toast-msg{padding:10px 14px 10px 8px;flex:1;line-height:1.45;font-weight:500}\n  #toast.show{opacity:1;transform:translateX(-50%) translateY(0)}\n  #toast.ok .toast-bar{background:var(--ok)}\n  #toast.ok .toast-icon{color:var(--ok)}\n  #toast.err .toast-bar{background:var(--err)}\n  #toast.err .toast-icon{color:var(--err)}\n  #toast.warn .toast-bar{background:#b7812c}\n  #toast.warn .toast-icon{color:#b7812c}\n  .toast-title{display:block}\n  .toast-detail{display:block;color:var(--muted);font-size:12px;font-weight:500;margin-top:2px}\n\n  /* شاشة الدخول */\n  .login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;\n    background:linear-gradient(135deg,#123a46,#1a4d5c 58%,#315b62);padding:18px}\n  .login-card{background:#fff;border-radius:12px;width:100%;max-width:440px;\n    padding:35px 35px 32px;box-shadow:0 20px 60px rgba(0,0,0,.3);text-align:center;\n    border-top:5px solid var(--accent)}\n  .login-logo{width:120px;height:120px;object-fit:contain;margin:0 auto 12px;display:block}\n  .login-card .brand{font-size:30px;font-weight:800;color:var(--brand);letter-spacing:0}\n  .brand-sub{font-size:15px;color:var(--accent);font-weight:700;margin-top:2px}\n  .login-card .org-name{font-size:13.5px;color:var(--muted);margin:12px 0 24px;line-height:1.7}\n  \n  .login-instructions{background:#f8f9fa;border:1px solid var(--line);border-radius:8px;\n    padding:12px;font-size:13.5px;color:var(--brand-deep);font-weight:600;margin-bottom:20px}\n  \n  .input-group{text-align:right;margin-bottom:12px}\n  .input-group label{display:block;margin-bottom:8px;font-size:14px;color:var(--brand-deep)}\n  .login-card input{text-align:right;font-size:16px;letter-spacing:1px;padding:12px 14px}\n  .pw-wrap{position:relative}\n  .pw-wrap input{padding-inline-end:66px}\n  .pw-toggle{position:absolute;inset-inline-end:8px;top:50%;transform:translateY(-50%);\n    background:none;border:none;color:var(--muted);font-size:12px;cursor:pointer;\n    font-family:inherit;padding:4px 6px;border-radius:4px}\n  .pw-toggle:hover{background:#eef2f4;color:var(--brand-deep)}\n  .caps-hint{display:block;font-size:11.5px;color:var(--warn);margin-top:6px;min-height:14px}\n  .login-note{font-size:12px;color:var(--muted);margin-top:14px;line-height:1.7;text-align:center}\n  \n  .login-actions{display:flex;flex-direction:column;gap:12px;margin-top:20px}\n  .login-card .btn{width:100%}\n  .remember-row{display:flex;align-items:center;gap:8px;justify-content:flex-start;\n    margin:10px 0 0;color:var(--muted);font-size:13.5px;font-weight:600;cursor:pointer}\n  .remember-row input{width:18px;height:18px;accent-color:var(--brand);cursor:pointer}\n  .install-btn{margin-top:0 !important}\n  .login-err{color:var(--err);font-size:13.5px;margin-top:12px;min-height:18px;font-weight:600}\n\n  .loading{text-align:center;color:var(--muted);padding:30px;font-size:13px}\n  .spin{display:inline-block;width:16px;height:16px;border:2px solid var(--line);\n    border-top-color:var(--brand);border-radius:50%;animation:sp .7s linear infinite;vertical-align:middle}\n  .spin.tiny{width:13px;height:13px;border-width:2px;margin-inline-end:2px}\n  @keyframes sp{to{transform:rotate(360deg)}}\n  @media(max-width:1100px){\n    .topbar-inner{align-items:flex-start;flex-wrap:wrap}\n    .app-title{position:static;transform:none;order:2;width:100%;justify-content:center;\n      border-top:1px solid rgba(255,255,255,.14);padding-top:7px;margin-top:3px}\n  }\n  @media(max-width:680px){\n    .rec{flex-wrap:wrap}\n    .rec-thumb{width:72px;height:72px}\n    .rec .ttl{font-size:15.5px}\n    .rec .ops{width:100%;flex-basis:100%}\n    .rec .ops .btn{flex:1}\n    .mini-rec{grid-template-columns:1fr}\n    .validation-panel{left:12px;right:12px;top:auto;bottom:76px;width:auto}\n  }\n"
